# HTTP + Socket.IO
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Public IP or DNS of THIS server (required for WebRTC / TURN clients)
# Use the same host students and teachers connect to.
PUBLIC_IP=127.0.0.1

# mediasoup WebRTC listen / announce
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=0

# Teacher reconnect grace (ms). Recording and room stay alive during this window.
TEACHER_RECONNECT_GRACE_MS=120000

# Cloud recordings directory (server disk). Optionally sync this folder to S3/GCS.
RECORDINGS_DIR=./recordings

# coturn on the same server
TURN_ENABLED=true
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_USERNAME=classroom
TURN_CREDENTIAL=change-this-turn-secret
STUN_URLS=stun:stun.l.google.com:19302,stun:127.0.0.1:3478
