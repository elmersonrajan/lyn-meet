PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=https://59.96.57.40:5173,https://192.168.1.55:5173,http://localhost:5173

PUBLIC_IP=59.96.57.40
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=59.96.57.40
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49000
MEDIASOUP_NUM_WORKERS=0

TEACHER_RECONNECT_GRACE_MS=120000

# ---------------------------------------------------------------------------
# How much data a class costs
#
# Sent to every browser when it joins, so these can be tuned for the
# connections the teachers actually have without rebuilding the frontend.
# A restart is enough.
#
# The teacher's camera is sent as THREE sizes at once -- simulcast -- and the
# server hands each student the one their connection can carry, switching as it
# changes. This is what Meet and Zoom do. One size cannot serve a room: small
# enough for the worst line means blurry for everyone else, and blurry in the
# recording.
#
#   CAM_LOW    320x180   a bad phone line
#   CAM_MID    640x360   the ordinary case
#   CAM_HIGH  1280x720   a good connection, and what the recording is made from
#
# The capture is CAM_WIDTH x CAM_HEIGHT and the lower rungs are scaled down from
# it, so the capture must be the size of the TOP rung or the top rung is a
# stretched smaller picture.
#
# Cost: the teacher's uplink carries roughly the sum, about 2.2 Mbps at full
# tilt. Their browser drops the upper rungs by itself when it cannot keep up.
# If teacher uplinks are the real constraint, lower CAM_HIGH_BITRATE first --
# it is most of the total -- and only then consider CAM_SIMULCAST=0.
# ---------------------------------------------------------------------------
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=24
CAM_LOW_BITRATE=150000
CAM_MID_BITRATE=500000
CAM_HIGH_BITRATE=1500000

# 0 goes back to a single stream at CAM_MAX_BITRATE: one size for everybody,
# including the recording. Only worth it on a site where teacher uplinks cannot
# carry the ladder at all.
CAM_SIMULCAST=1
CAM_MAX_BITRATE=600000

# Which rung the recording is made from. The recorder has no congestion control
# for mediasoup to estimate, so without this it sits on the bottom rung and an
# hour of class is recorded at 320x180. Defaults to the top rung.
# RECORDING_SPATIAL_LAYER=2

# maintain-framerate keeps motion smooth and lets sharpness go; use
# maintain-resolution for a camera pointed at a whiteboard or a page.
CAM_DEGRADATION=maintain-framerate

# A student whose connection cannot carry even the smallest rung is dropped to
# audio deliberately, rather than left watching a frozen tile, and offered the
# picture back later in case the line recovered. They can also choose for
# themselves at any time. 0 on either switches that automatic half off and
# leaves only the manual choice.
LOW_BANDWIDTH_AUDIO_AFTER_MS=12000
LOW_BANDWIDTH_RETRY_MS=45000

# A screen share keeps its resolution -- text has to stay readable -- and is
# capped on bitrate instead. Raise SCREEN_MAX_FPS towards 30 if videos played
# through Play Video look choppy. It stays a single stream: there is no smaller
# version of a spreadsheet worth sending.
SCREEN_MAX_BITRATE=1200000
SCREEN_MAX_FPS=24

# The ceiling on everything one person sends, enforced by the server rather
# than requested of the browser. Must fit the whole camera ladder and a screen
# share at once.
MAX_INCOMING_BITRATE=3800000

# ---------------------------------------------------------------------------
# What a teacher can put on the whiteboard
#
# Pictures arrive as pixels over the socket; documents arrive as files and are
# rendered by every browser. Both are the pages of one lesson, not a library,
# so both are swept after a day.
#
# A Word document is converted to PDF by LibreOffice. Without `soffice` on this
# machine the teacher is told to save it as a PDF rather than left waiting:
#   sudo dnf install libreoffice-writer   (or apt install libreoffice-writer)
# ---------------------------------------------------------------------------
# Pictures and documents are deleted when their meeting closes. These are the
# backstop for whatever a crash left behind, and the sweep runs on a timer as
# well as at boot -- a server that stays up for a month would otherwise never
# sweep at all, which is how "temporary" quietly becomes "forever".
BOARD_IMAGE_MAX_AGE_HOURS=6
DOCUMENT_MAX_AGE_HOURS=6
MATERIAL_SWEEP_MINUTES=30
# Kept under the socket's own 20 MB frame limit.
DOCUMENT_MAX_BYTES=18874368
DOCUMENT_CONVERT_TIMEOUT_MS=60000
# ---------------------------------------------------------------------------
# What a finished recording looks like
#
# The board fills the frame and the teacher's camera sits in the corner. That
# corner used to be a sixth of the width -- 214 pixels, a face too small to
# read an expression on, which is most of what "the camera looks bad in the
# recording" means. A quarter is 320 and still leaves the board readable.
#
# RECORDING_PIP_WIDTH overrides the fraction outright: a lecture wants the
# teacher bigger, a worked example wants the board bigger.
# ---------------------------------------------------------------------------
RECORDING_WIDTH=1280
RECORDING_HEIGHT=720
RECORDING_PIP_FRACTION=4
# RECORDING_PIP_WIDTH=420

# The board is flat colour and costs nothing to encode; the camera inset is the
# only detailed part of the frame, so a lower crf is what buys a sharper face.
# Lower is sharper and bigger: 21 is noticeably better and about a quarter
# larger, 26 is smaller and softer. `slow` sharpens further at real render cost
# on a box that is also running the SFU.
RECORDING_CRF=23
RECORDING_PRESET=veryfast

RECORDINGS_DIR=./recordings

TURN_ENABLED=true
TURN_URLS=turn:59.96.57.40:3478?transport=udp,turn:59.96.57.40:3478?transport=tcp
TURN_USERNAME=classroom
TURN_CREDENTIAL=change-this-turn-secret
STUN_URLS=stun:59.96.57.40:3478,stun:stun.l.google.com:19302

# ---------------------------------------------------------------------------
# SSO bridge with lynindia.in
#
# Generate BOTH secrets with:  openssl rand -hex 32
# They must differ from each other. SSO_SHARED_SECRET is the only value that
# is also configured on lynindia.in; SESSION_SECRET never leaves this server.
# ---------------------------------------------------------------------------
SSO_SHARED_SECRET=
SESSION_SECRET=

# Claims the hand-off ticket must carry. A ticket minted for anything else is
# refused, so a token stolen from another integration cannot be used here.
SSO_ISSUER=https://lynindia.in
SSO_AUDIENCE=https://meet.lynindia.in

# Where an unauthenticated visitor is sent. Must be the endpoint on the main
# site that checks its own session and redirects back with a ticket.
SSO_LOGIN_URL=https://lynindia.in/sso/authorize
SITE_URL=https://lynindia.in

# Ticket lifetime in seconds. Long enough for a redirect on a slow phone,
# short enough that a leaked URL is worthless. Do not raise this above ~120.
SSO_TICKET_MAX_AGE_SEC=60
SSO_CLOCK_TOLERANCE_SEC=10

# Meeting session cookie: one long teaching day.
SESSION_MAX_AGE_SEC=28800
SESSION_COOKIE_NAME=lynmeet_sid
# Leave blank for a host-only cookie on meet.lynindia.in. Set to .lynindia.in
# ONLY if the parent site genuinely needs to read it.
SESSION_COOKIE_DOMAIN=

# Hosts accepted as a post-login redirect target, comma separated. Anything
# else falls back to "/" so this endpoint cannot be used as an open redirector.
ALLOWED_REDIRECT_HOSTS=meet.lynindia.in

# ---------------------------------------------------------------------------
# Platform database (read-only user directory)
#
# This app creates no user records. Authorisation is answered by v_Users, the
# same view lynindia.in uses, so removing someone there removes them here.
#
# SELECT is enough for authorisation. Attendance and recordings additionally
# need INSERT and UPDATE on the five tables listed below -- and nothing else.
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=11038
DB_USER=
DB_PASS=
DB_NAME=LYNDev
DB_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Attendance and recordings in the platform's own tables
#
# Attendance is written to the .jsonl file first and mirrored into MySQL from
# there, so a database outage delays these rows rather than losing them --
# replay a missed class with:  node scripts/backfill-attendance.js <ScheduleID>
#
#   AttendanceLog      one row per period of presence (in, out, ScheduleID)
#   Attendance         the register, for students
#   TeacherAttendance  the teacher who took the class
#   AdminAttendance    a coordinator supervising it
#
# NOTE: the DB account needs INSERT and UPDATE on these four tables plus
# YouTubeRecords, and SELECT on ClassSchedule/ClassSubject. SELECT alone is no
# longer enough.
# ---------------------------------------------------------------------------
ATTENDANCE_DB_WRITES=1

# Stamped on every register row this server writes. It is also what makes the
# upsert safe: a row is only ever overwritten when it carries this same value,
# so attendance uploaded by a centre or by the site itself is never replaced.
ATTENDANCE_UPLOADED_BY=LYN MEET

# Finished recordings are published to YouTubeRecords as (ScheduleID, VideoURL).
RECORDING_DB_WRITES=1

# Where recordings are reachable from outside this server. The row is only as
# useful as this URL. Defaults to SSO_AUDIENCE when unset, and with NEITHER set
# nothing is ever written -- which is the commonest reason for an empty
# YouTubeRecords. `npm run check:recording-db` says so in as many words.
RECORDING_PUBLIC_BASE_URL=https://meet.lynindia.in

# How often to retry recordings that rendered while the database was
# unreachable. The live write happens once; without this a single outage loses
# the link for good. 0 switches the retry off.
RECORDING_SWEEP_MINUTES=15

# The recording is composed on this server, so the board it draws includes the
# page under the strokes: a pasted picture (decoded by ffmpeg, already
# required) and a page of a PDF or Word document (rendered by poppler --
# `apt install poppler-utils`). Without poppler a class spent on a document
# records the strokes and lists the page as dropped.
# BOARD_PAGE_PDF_DPI=110
# BOARD_PAGE_CACHE=16

# Local development only. Ignored when NODE_ENV=production. With this set the
# server skips SSO entirely and treats every visitor as a teacher.
# AUTH_DISABLED=1

# ---------------------------------------------------------------------------
# Meeting-level authorisation
#
# Rooms are ClassSchedule.ScheduleID, which is a sequential integer -- anyone
# signed in can count downwards and try other classes. These checks are what
# stop that, so leave them on.
# ---------------------------------------------------------------------------

# Students may only join a class they are enrolled in (Students.Class, or a
# same-day StudentException). Non-student members join as observers.
ENFORCE_ENROLMENT=1

# Only the teacher named on the schedule gets teacher powers; any other
# teacher joins as an observer rather than being refused, so a substitute is
# never locked out. A coordinator can always run the class.
TEACHER_MUST_MATCH_SCHEDULE=1

# Refuse a class whose ScheduleDate is not today. Off by default: the
# platform's first test link pointed at a schedule dated the previous day, and
# a hard rule here would have refused it. Turn on once scheduling is reliable.
REQUIRE_SCHEDULE_TODAY=0

# Allow rooms that are not a ScheduleID at all (e.g. MATH-101). Needed for
# testing without a real class row; keep off in production or room names
# become unauthenticated free-for-alls again.
ALLOW_ADHOC_ROOMS=0
