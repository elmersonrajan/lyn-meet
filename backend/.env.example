PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=https://59.96.57.40:5173,https://192.168.1.55:5173,http://localhost:5173

PUBLIC_IP=59.96.57.40
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=59.96.57.40
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49000
MEDIASOUP_NUM_WORKERS=0

TEACHER_RECONNECT_GRACE_MS=120000
RECORDINGS_DIR=./recordings

TURN_ENABLED=true
TURN_URLS=turn:59.96.57.40:3478?transport=udp,turn:59.96.57.40:3478?transport=tcp
TURN_USERNAME=classroom
TURN_CREDENTIAL=change-this-turn-secret
STUN_URLS=stun:59.96.57.40:3478,stun:stun.l.google.com:19302

# ---------------------------------------------------------------------------
# SSO bridge with lynindia.in
#
# Generate BOTH secrets with:  openssl rand -hex 32
# They must differ from each other. SSO_SHARED_SECRET is the only value that
# is also configured on lynindia.in; SESSION_SECRET never leaves this server.
# ---------------------------------------------------------------------------
SSO_SHARED_SECRET=
SESSION_SECRET=

# Claims the hand-off ticket must carry. A ticket minted for anything else is
# refused, so a token stolen from another integration cannot be used here.
SSO_ISSUER=https://lynindia.in
SSO_AUDIENCE=https://meet.lynindia.in

# Where an unauthenticated visitor is sent. Must be the endpoint on the main
# site that checks its own session and redirects back with a ticket.
SSO_LOGIN_URL=https://lynindia.in/sso/authorize
SITE_URL=https://lynindia.in

# Ticket lifetime in seconds. Long enough for a redirect on a slow phone,
# short enough that a leaked URL is worthless. Do not raise this above ~120.
SSO_TICKET_MAX_AGE_SEC=60
SSO_CLOCK_TOLERANCE_SEC=10

# Meeting session cookie: one long teaching day.
SESSION_MAX_AGE_SEC=28800
SESSION_COOKIE_NAME=lynmeet_sid
# Leave blank for a host-only cookie on meet.lynindia.in. Set to .lynindia.in
# ONLY if the parent site genuinely needs to read it.
SESSION_COOKIE_DOMAIN=

# Hosts accepted as a post-login redirect target, comma separated. Anything
# else falls back to "/" so this endpoint cannot be used as an open redirector.
ALLOWED_REDIRECT_HOSTS=meet.lynindia.in

# ---------------------------------------------------------------------------
# Platform database (read-only user directory)
#
# This app creates no user records. Authorisation is answered by v_Users, the
# same view lynindia.in uses, so removing someone there removes them here.
# Grant this account SELECT only.
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=11038
DB_USER=
DB_PASS=
DB_NAME=LYNDev
DB_POOL_SIZE=5

# Local development only. Ignored when NODE_ENV=production. With this set the
# server skips SSO entirely and treats every visitor as a teacher.
# AUTH_DISABLED=1
