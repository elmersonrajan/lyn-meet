# Copy to /etc/turnserver.conf on the SAME server that runs this app.
# Then: sudo systemctl restart coturn

listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
external-ip=YOUR_PUBLIC_IP

# Long-term credentials (must match backend .env TURN_USERNAME / TURN_CREDENTIAL)
lt-cred-mech
user=classroom:change-this-turn-secret
realm=classroom.meet

fingerprint
no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600

# Relay ports — open these in the firewall together with 3478/5349 UDP+TCP
min-port=49152
max-port=65535

# Logging
verbose
log-file=/var/log/turnserver.log
